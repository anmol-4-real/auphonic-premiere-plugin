{
  "manifestVersion": 5,
  "id": "com.hackerrank.auphonic-premiere",
  "name": "Awwphonic Audio Processor",
  "shortname": "awwphonic",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "https://auphonic.com",
        "https://*.auphonic.com"
      ]
    },
    "launchProcess": {
      "schemes": ["https", "mailto"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "auphonicPanel",
      "label": { "default": "Awwphonic Audio Processor" },
      "minimumSize": { "width": 420, "height": 520 },
      "preferredDockedSize": { "width": 520, "height": 720 }
    }
  ]
}
