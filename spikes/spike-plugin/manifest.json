{
  "manifestVersion": 5,
  "id": "com.hackerrank.auphonic-spike",
  "name": "Auphonic Spike Tests",
  "shortname": "auphspike",
  "version": "0.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "network": {
      "domains": [
        "https://auphonic.com",
        "https://*.auphonic.com"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "spikePanel",
      "type": "panel",
      "label": { "default": "Auphonic Spike Tests" },
      "minimumSize": { "width": 420, "height": 480 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 480, "height": 700 },
      "preferredFloatingSize": { "width": 520, "height": 720 }
    }
  ]
}
